# ============================================================
# breeze-qq-bot 配置示例：复制为 .env 后按需修改
#   Windows:  copy .env.example .env
#   Linux/Mac: cp .env.example .env
# 留空表示使用默认值或未配置
# ============================================================

# ---------- NapCat 反向 WebSocket ----------
# 本程序作为 ws 服务端监听的地址，默认 127.0.0.1（只允许本机连）
WS_HOST=127.0.0.1
# 监听端口，默认 8080；被占用改这里，NapCat 同步改
WS_PORT=8080
# 反向 WS 路径，默认 /onebot/v11/ws，必须与 NapCat 配置一致
WS_PATH=/onebot/v11/ws

# ---------- 安全 ----------
# 允许私聊的 QQ 号，英文逗号分隔，如 12345678,87654321
# 留空 = 拒绝所有人（启动日志会打 WARNING）
ALLOWED_USERS=
# 同一用户两次触发的最小间隔（秒），默认 3，防刷屏
MIN_INTERVAL_SEC=3
# 消息去重缓存时长（秒），默认 600，按 message_id 去重
DEDUP_TTL_SEC=600

# ---------- 对话模型 ----------
# 对话后端：ollama（本地）或 openai（任意 OpenAI 兼容 API）
CHAT_PROVIDER=ollama
# 人设 system prompt，想换性格就改这里
SYSTEM_PROMPT=你是一个温柔、话不多的 QQ 私聊机器人，用口语化的中文聊天，回复尽量简短。
# 回复最大字数，默认 500，超出在句末标点处截断
MAX_REPLY_CHARS=500
# 每个用户保留多少轮上下文，默认 10，填 0 表示不带上下文
CHAT_HISTORY_TURNS=10
# 生成温度，默认 0.8（0 最稳定，1 最发散）
CHAT_TEMPERATURE=0.8
# 对话请求超时（秒），默认 90
CHAT_TIMEOUT_SEC=90

# --- 后端 A：本地 ollama ---
# ollama 服务地址，默认 http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 模型名，需先 ollama pull，例如 qwen2.5:7b
OLLAMA_MODEL=qwen2.5:7b

# --- 后端 B：OpenAI 兼容（DeepSeek / 硅基流动 / 官方均可）---
# base_url 要带 /v1 结尾，例如 https://api.deepseek.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
# 你的 API Key（下面只是占位符，别把真钥匙提交进 git）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 模型名，例如 gpt-4o-mini、deepseek-chat
OPENAI_MODEL=gpt-4o-mini

# ---------- BreezeBlue TTS ----------
# 总开关：true 发语音，false 只发文字（默认 true）
ENABLE_TTS=true
# 官方 API 根地址，默认 https://api.breeze.blue/v1
BREEZE_API_BASE=https://api.breeze.blue/v1
# 控制台拿到的 API Key，请求头 xi-api-key 用
BREEZE_API_KEY=
# 克隆音色后拿到的 voice_id，拼在 /text-to-speech/{voice_id}
BREEZE_VOICE_ID=
# 模型 id，默认 breeze-tts-2，一般不用改
BREEZE_MODEL_ID=breeze-tts-2
# 语言代码，默认 zh（中文）
BREEZE_LANGUAGE=zh
# 输出格式，默认 mp3_24000_64
BREEZE_OUTPUT_FORMAT=mp3_24000_64
# 语速，默认 1.0，范围大致 0.5~2.0
TTS_SPEED=1.0
# 音色引导强度，默认 1.0
TTS_GUIDANCE=1.0
# 是否增强说话人特征，默认 true
TTS_SPEAKER_BOOST=true
# 送给 TTS 的文本最大字数，默认 80，超出在句号处截断
TTS_MAX_CHARS=80
# TTS 最大并发数，默认 1，调大容易被限流（429）
TTS_CONCURRENCY=1
# 遇到 429 最多请求次数（含首次），默认 3
TTS_MAX_RETRIES=3
# 单个 TTS 请求超时（秒），默认 60
TTS_TIMEOUT_SEC=60

# ---------- 语音文件 ----------
# mp3/silk 存放目录，默认 data/voice（相对项目根目录）
VOICE_DIR=data/voice
# 语音文件保留时长（小时），默认 6，超时自动删除
VOICE_KEEP_HOURS=6
# 清理检查间隔（秒），默认 1800（30 分钟）
VOICE_CLEAN_INTERVAL_SEC=1800

# ---------- 日志 ----------
# 日志目录，默认 logs，按天切分文件
LOG_DIR=logs
# 日志级别：DEBUG / INFO / WARNING / ERROR，默认 INFO
LOG_LEVEL=INFO
